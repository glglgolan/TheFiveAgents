# Example environment variables for TheFiveAgents
# Copy this file to .env and fill in your values

# Anthropic API Key (required)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key (for gpt-image-gen skill)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Admin Key (sk-admin-...) — required for Dana / usage-analytics skill.
# Get from https://platform.openai.com/settings/organization/admin-keys
# The regular project key above CANNOT access /v1/organization/usage endpoints.
OPENAI_ADMIN_KEY=sk-admin-your_admin_key_here

# OpenRouter API Key
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model settings (optional)
CLAUDE_MODEL=claude-sonnet-4-6

# Agent settings (optional)
MAX_TOKENS=8096
